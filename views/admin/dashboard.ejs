<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-8 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Admin Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-wider mb-2">
          <i class="fa-solid fa-shield-halved text-xs"></i> Administrator Panel
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Store Management Dashboard</h1>
      </div>
      <div class="flex space-x-3">
        <a href="/admin/books/add" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-2">
          <i class="fa-solid fa-plus"></i> Add New Book
        </a>
        <a href="/admin/books" class="px-4 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-2">
          <i class="fa-solid fa-boxes-stacked"></i> View Inventory
        </a>
      </div>
    </div>

    <!-- 4 Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Revenue -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Sales</span>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-dollar-sign"></i>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-slate-900 mt-2">$<%= stats.totalRevenue %></p>
        <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-1">
          <i class="fa-solid fa-arrow-trend-up"></i> Live revenue generated
        </span>
      </div>

      <!-- Total Orders -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Orders</span>
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-slate-900 mt-2"><%= stats.totalOrders %></p>
        <span class="text-[11px] text-slate-500 flex items-center gap-1 mt-1">
          <a href="/admin/orders" class="text-brand-600 hover:underline">Manage orders &rarr;</a>
        </span>
      </div>

      <!-- Total Books -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Books in Stock</span>
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-book"></i>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-slate-900 mt-2"><%= stats.totalBooks %></p>
        <span class="text-[11px] text-slate-500 flex items-center gap-1 mt-1">
          <a href="/admin/books" class="text-brand-600 hover:underline">View inventory &rarr;</a>
        </span>
      </div>

      <!-- Customers -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Registered Users</span>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-slate-900 mt-2"><%= stats.totalUsers %></p>
        <span class="text-[11px] text-slate-500 flex items-center gap-1 mt-1">
          Customer database
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Recent Orders Table (Col 7) -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="font-bold text-base text-slate-900">Recent Customer Orders</h2>
          <a href="/admin/orders" class="text-xs text-brand-600 hover:text-brand-800 font-semibold">View All &rarr;</a>
        </div>

        <% if (recentOrders.length === 0) { %>
          <p class="text-xs text-slate-500 py-6 text-center">No orders placed yet.</p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-slate-100 text-slate-400 font-bold uppercase text-[10px]">
                  <th class="pb-2">Order</th>
                  <th class="pb-2">Customer</th>
                  <th class="pb-2">Total</th>
                  <th class="pb-2">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% recentOrders.forEach(o => { %>
                  <tr class="hover:bg-slate-50/80">
                    <td class="py-3 font-bold font-mono">#<%= o.id %></td>
                    <td class="py-3 text-slate-700 font-medium"><%= o.shipping_name %></td>
                    <td class="py-3 font-bold text-slate-900">$<%= parseFloat(o.total_amount).toFixed(2) %></td>
                    <td class="py-3">
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= o.order_status === 'Delivered' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                        <%= o.order_status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Low Stock Warnings (Col 5) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="font-bold text-base text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
            <span>Low Stock Alert</span>
          </h2>
          <span class="text-xs text-slate-400">Under 10 units</span>
        </div>

        <% if (lowStockBooks.length === 0) { %>
          <p class="text-xs text-emerald-600 py-6 text-center font-medium">All book stocks are healthy!</p>
        <% } else { %>
          <div class="divide-y divide-slate-100 space-y-2">
            <% lowStockBooks.forEach(b => { %>
              <div class="pt-2 flex items-center justify-between text-xs">
                <div class="truncate pr-2">
                  <p class="font-bold text-slate-800 truncate"><%= b.title %></p>
                  <p class="text-slate-400 text-[11px]"><%= b.category_name %></p>
                </div>
                <div class="flex items-center space-x-2 shrink-0">
                  <span class="px-2 py-0.5 bg-rose-50 text-rose-700 font-bold rounded text-[10px]">
                    <%= b.stock_quantity %> left
                  </span>
                  <a href="/admin/books/edit/<%= b.id %>" class="text-brand-600 hover:text-brand-800 font-semibold">
                    Restock
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
