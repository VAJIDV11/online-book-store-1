<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-8 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center text-xs text-slate-500 space-x-2 mb-2">
        <a href="/admin" class="hover:text-brand-600 transition">Admin Dashboard</a>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">Orders</span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Manage Customer Orders</h1>
    </div>

    <!-- Orders Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden p-6 sm:p-8 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <p class="text-xs text-slate-500">Total orders received: <strong class="text-slate-800"><%= orders.length %></strong></p>
      </div>

      <% if (orders.length === 0) { %>
        <p class="text-xs text-slate-500 py-12 text-center">No customer orders recorded yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-slate-100 text-slate-400 font-bold uppercase text-[10px]">
                <th class="pb-3">Order ID</th>
                <th class="pb-3">Date</th>
                <th class="pb-3">Customer</th>
                <th class="pb-3">Total</th>
                <th class="pb-3">Payment</th>
                <th class="pb-3">Update Order Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% orders.forEach(order => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-3.5 font-bold font-mono text-slate-900">#<%= order.id %></td>
                  <td class="py-3.5 text-slate-600"><%= new Date(order.created_at).toLocaleDateString() %></td>
                  <td class="py-3.5">
                    <p class="font-bold text-slate-900"><%= order.shipping_name %></p>
                    <p class="text-[11px] text-slate-400"><%= order.user_email %></p>
                  </td>
                  <td class="py-3.5 font-bold text-slate-900">$<%= parseFloat(order.total_amount).toFixed(2) %></td>
                  <td class="py-3.5">
                    <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 font-bold rounded-full text-[10px]">
                      <%= order.payment_status %>
                    </span>
                  </td>
                  <td class="py-3.5">
                    <form action="/admin/orders/update-status/<%= order.id %>" method="POST" class="flex items-center space-x-2">
                      <select name="order_status" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-lg text-xs py-1 px-2.5 text-slate-800 font-semibold focus:outline-none focus:border-brand-500">
                        <option value="Processing" <%= order.order_status === 'Processing' ? 'selected' : '' %>>Processing</option>
                        <option value="Shipped" <%= order.order_status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                        <option value="Delivered" <%= order.order_status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                        <option value="Cancelled" <%= order.order_status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                      </select>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
