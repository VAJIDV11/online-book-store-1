<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-8 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center text-xs text-slate-500 space-x-2 mb-2">
        <a href="/admin" class="hover:text-brand-600 transition">Admin Dashboard</a>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <a href="/admin/books" class="hover:text-brand-600 transition">Inventory</a>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold"><%= isEdit ? 'Edit Book' : 'Add New Book' %></span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900"><%= isEdit ? 'Update Book Details' : 'Add New Book to Catalogue' %></h1>
    </div>

    <!-- Server Validation Errors -->
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs">
        <div class="font-bold flex items-center gap-1.5 mb-1.5">
          <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
          <span>Please fix the following validation errors:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-rose-700">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Book Form Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10">
      <form action="<%= isEdit ? '/admin/books/edit/' + book.id : '/admin/books/add' %>" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          
          <!-- Book Title -->
          <div class="sm:col-span-2">
            <label for="title" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Book Title *</label>
            <input 
              type="text" 
              id="title" 
              name="title" 
              required 
              value="<%= typeof book !== 'undefined' && book.title ? book.title : '' %>"
              placeholder="e.g. Clean Architecture: A Craftsman's Guide" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Author -->
          <div>
            <label for="author" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Author Name *</label>
            <input 
              type="text" 
              id="author" 
              name="author" 
              required 
              value="<%= typeof book !== 'undefined' && book.author ? book.author : '' %>"
              placeholder="e.g. Robert C. Martin" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Category -->
          <div>
            <label for="category_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category *</label>
            <select 
              id="category_id" 
              name="category_id" 
              required 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
              <option value="">Select Category</option>
              <% if (typeof categories !== 'undefined') { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= (typeof book !== 'undefined' && book.category_id == cat.id) ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- ISBN -->
          <div>
            <label for="isbn" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">ISBN Number (Optional)</label>
            <input 
              type="text" 
              id="isbn" 
              name="isbn" 
              value="<%= typeof book !== 'undefined' && book.isbn ? book.isbn : '' %>"
              placeholder="9780134494166" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Stock Quantity -->
          <div>
            <label for="stock_quantity" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Stock Quantity *</label>
            <input 
              type="number" 
              id="stock_quantity" 
              name="stock_quantity" 
              required 
              min="0"
              value="<%= typeof book !== 'undefined' && book.stock_quantity !== undefined ? book.stock_quantity : '25' %>"
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Standard Price -->
          <div>
            <label for="price" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Standard Price ($) *</label>
            <input 
              type="number" 
              step="0.01" 
              id="price" 
              name="price" 
              required 
              min="0.01"
              value="<%= typeof book !== 'undefined' && book.price ? book.price : '' %>"
              placeholder="39.99" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Discount Price -->
          <div>
            <label for="discount_price" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Discount Price ($) (Optional)</label>
            <input 
              type="number" 
              step="0.01" 
              id="discount_price" 
              name="discount_price" 
              min="0.00"
              value="<%= typeof book !== 'undefined' && book.discount_price ? book.discount_price : '' %>"
              placeholder="29.99" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Cover Image URL -->
          <div class="sm:col-span-2">
            <label for="cover_image" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Cover Image URL</label>
            <input 
              type="url" 
              id="cover_image" 
              name="cover_image" 
              value="<%= typeof book !== 'undefined' && book.cover_image ? book.cover_image : '' %>"
              placeholder="https://images.unsplash.com/..." 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            >
          </div>

          <!-- Description -->
          <div class="sm:col-span-2">
            <label for="description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Book Synopsis / Description *</label>
            <textarea 
              id="description" 
              name="description" 
              rows="4" 
              required 
              placeholder="Detailed description of the book..."
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500"
            ><%= typeof book !== 'undefined' && book.description ? book.description : '' %></textarea>
          </div>

          <!-- Is Featured Checkbox -->
          <div class="sm:col-span-2">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input 
                type="checkbox" 
                name="is_featured" 
                value="1" 
                <%= (typeof book !== 'undefined' && (book.is_featured === 1 || book.is_featured === true || book.is_featured === '1')) ? 'checked' : '' %>
                class="rounded text-brand-600 focus:ring-brand-500"
              >
              <span class="text-xs font-bold text-slate-700">Display as Featured Book on Home Page</span>
            </label>
          </div>

        </div>

        <!-- Submit & Cancel Buttons -->
        <div class="pt-6 border-t border-slate-100 flex items-center justify-end space-x-3">
          <a href="/admin/books" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
            Cancel
          </a>
          <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk"></i>
            <span><%= isEdit ? 'Save Changes' : 'Create Book' %></span>
          </button>
        </div>

      </form>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
