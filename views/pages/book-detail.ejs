<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-8 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs text-slate-500 space-x-2 mb-8">
      <a href="/" class="hover:text-brand-600 transition">Home</a>
      <i class="fa-solid fa-chevron-right text-[10px]"></i>
      <a href="/catalogue" class="hover:text-brand-600 transition">Catalogue</a>
      <i class="fa-solid fa-chevron-right text-[10px]"></i>
      <a href="/catalogue?category=<%= book.category_slug %>" class="hover:text-brand-600 transition"><%= book.category_name %></a>
      <i class="fa-solid fa-chevron-right text-[10px]"></i>
      <span class="text-slate-800 font-semibold truncate max-w-xs"><%= book.title %></span>
    </nav>

    <!-- Product Details Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden p-6 sm:p-10 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        
        <!-- Book Cover Image -->
        <div class="md:col-span-5 flex justify-center bg-slate-50 rounded-2xl p-8 border border-slate-100">
          <div class="relative group">
            <img 
              src="<%= book.cover_image || 'https://covers.openlibrary.org/b/isbn/9780132350884-L.jpg' %>" 
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80';"
              alt="<%= book.title %>" 
              class="h-80 sm:h-96 object-cover rounded-xl shadow-xl transition transform group-hover:scale-105 duration-300"
            >
            <% if (book.discount_price) { %>
              <span class="badge-discount absolute -top-3 -left-3 text-white text-xs font-extrabold uppercase px-3 py-1 rounded-full shadow-md">
                Special Offer
              </span>
            <% } %>
          </div>
        </div>

        <!-- Book Meta & Purchase Flow -->
        <div class="md:col-span-7 flex flex-col justify-between space-y-6">
          
          <div>
            <!-- Category Tag -->
            <a href="/catalogue?category=<%= book.category_slug %>" class="inline-block px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-bold uppercase tracking-wider hover:bg-brand-100 transition">
              <%= book.category_name %>
            </a>

            <!-- Book Title -->
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2"><%= book.title %></h1>
            
            <!-- Author -->
            <p class="text-sm sm:text-base text-slate-600 mt-1">
              By <span class="font-bold text-slate-800"><%= book.author %></span>
            </p>

            <!-- Star Ratings & ISBN -->
            <div class="flex flex-wrap items-center gap-4 mt-3 pt-3 border-t border-slate-100 text-xs">
              <div class="flex items-center space-x-1 text-amber-400">
                <i class="fa-solid fa-star"></i>
                <span class="font-extrabold text-slate-800 text-sm ml-1"><%= book.rating || '4.5' %></span>
                <span class="text-slate-500">(<%= book.rating_count || 12 %> verified reviews)</span>
              </div>
              <span class="text-slate-300">|</span>
              <span class="text-slate-500">ISBN: <span class="font-semibold text-slate-700"><%= book.isbn || 'N/A' %></span></span>
            </div>

            <!-- Price Display -->
            <div class="mt-6 flex items-baseline space-x-3">
              <% if (book.discount_price) { %>
                <span class="text-3xl font-extrabold text-slate-900">$<%= parseFloat(book.discount_price).toFixed(2) %></span>
                <span class="text-base text-slate-400 line-through">$<%= parseFloat(book.price).toFixed(2) %></span>
                <% const savePct = Math.round(((book.price - book.discount_price) / book.price) * 100); %>
                <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Save <%= savePct %>%</span>
              <% } else { %>
                <span class="text-3xl font-extrabold text-slate-900">$<%= parseFloat(book.price).toFixed(2) %></span>
              <% } %>
            </div>

            <!-- Stock status -->
            <div class="mt-3">
              <% if (book.stock_quantity > 10) { %>
                <span class="inline-flex items-center text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                  In Stock (<%= book.stock_quantity %> units available)
                </span>
              <% } else if (book.stock_quantity > 0) { %>
                <span class="inline-flex items-center text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                  Low Stock - Only <%= book.stock_quantity %> left!
                </span>
              <% } else { %>
                <span class="inline-flex items-center text-xs font-semibold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>
                  Currently Out of Stock
                </span>
              <% } %>
            </div>

            <!-- Description -->
            <div class="mt-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Synopsis</h3>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed whitespace-pre-line"><%= book.description %></p>
            </div>
          </div>

          <!-- Purchase Controls -->
          <div class="pt-6 border-t border-slate-100">
            <% if (book.stock_quantity > 0) { %>
              <form action="/cart/add" method="POST" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <input type="hidden" name="book_id" value="<%= book.id %>">
                
                <!-- Quantity Selector -->
                <div class="flex items-center border border-slate-200 rounded-xl bg-slate-50 overflow-hidden w-full sm:w-32">
                  <button type="button" class="qty-decrement px-3.5 py-3 text-slate-500 hover:text-slate-800 transition">
                    <i class="fa-solid fa-minus text-xs"></i>
                  </button>
                  <input 
                    type="number" 
                    name="quantity" 
                    value="1" 
                    min="1" 
                    max="<%= book.stock_quantity %>" 
                    class="w-full text-center bg-transparent text-sm font-bold text-slate-800 focus:outline-none"
                  >
                  <button type="button" class="qty-increment px-3.5 py-3 text-slate-500 hover:text-slate-800 transition">
                    <i class="fa-solid fa-plus text-xs"></i>
                  </button>
                </div>

                <!-- Add to Cart Button -->
                <button type="submit" class="flex-1 py-3.5 px-6 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl shadow-lg shadow-brand-600/30 transition flex items-center justify-center space-x-2">
                  <i class="fa-solid fa-bag-shopping text-base"></i>
                  <span>Add to Cart</span>
                </button>
              </form>
            <% } else { %>
              <button disabled class="w-full py-3.5 px-6 bg-slate-100 text-slate-400 font-bold text-sm rounded-xl cursor-not-allowed">
                Out of Stock
              </button>
            <% } %>

            <!-- Safe guarantee badges -->
            <div class="grid grid-cols-2 gap-4 mt-6 text-xs text-slate-500">
              <div class="flex items-center space-x-2">
                <i class="fa-solid fa-truck text-brand-600"></i>
                <span>Dispatched within 24 hours</span>
              </div>
              <div class="flex items-center space-x-2">
                <i class="fa-solid fa-rotate-left text-brand-600"></i>
                <span>30-Day Hassle-Free Returns</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Related Books in the same category -->
    <% if (typeof relatedBooks !== 'undefined' && relatedBooks.length > 0) { %>
      <div class="mb-12">
        <h2 class="text-xl font-bold text-slate-900 mb-6">More from <span class="text-brand-600"><%= book.category_name %></span></h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          <% relatedBooks.forEach(relBook => { %>
            <div class="book-card bg-white rounded-2xl border border-slate-200/80 overflow-hidden flex flex-col justify-between shadow-sm">
              <div>
                <div class="bg-slate-50 p-5 flex items-center justify-center h-48 img-zoom-container">
                  <img src="<%= relBook.cover_image || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80' %>" alt="<%= relBook.title %>" class="h-36 object-cover rounded shadow">
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-xs text-slate-900 line-clamp-1 hover:text-brand-600 transition">
                    <a href="/books/<%= relBook.id %>"><%= relBook.title %></a>
                  </h3>
                  <p class="text-[11px] text-slate-500 mt-0.5"><%= relBook.author %></p>
                </div>
              </div>
              <div class="px-4 pb-4 pt-2 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-800">$<%= parseFloat(relBook.discount_price || relBook.price).toFixed(2) %></span>
                <a href="/books/<%= relBook.id %>" class="text-xs font-semibold text-brand-600 hover:text-brand-800 transition">View &rarr;</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
