<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-12 bg-slate-50 flex items-center justify-center">
  <div class="max-w-md w-full mx-4">
    
    <!-- Login Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl p-8 sm:p-10">
      
      <div class="text-center mb-8">
        <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mx-auto text-xl mb-3 shadow-inner">
          <i class="fa-solid fa-arrow-right-to-bracket"></i>
        </div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Welcome Back</h1>
        <p class="text-xs text-slate-500 mt-1">Sign in to your BookHaven account to continue.</p>
      </div>


      <!-- Server Validation Errors -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs">
          <div class="font-bold flex items-center gap-1.5 mb-1.5">
            <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
            <span>Login Error:</span>
          </div>
          <ul class="list-disc list-inside space-y-1 text-rose-700">
            <% errors.forEach(err => { %>
              <li><%= err.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        
        <!-- Email -->
        <div>
          <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
          <div class="relative">
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              placeholder="you@example.com" 
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition"
            >
            <i class="fa-regular fa-envelope absolute left-3.5 top-3 text-slate-400 text-xs"></i>
          </div>
        </div>

        <!-- Password -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Password</label>
            <a href="javascript:alert('For demo purposes, please use the pre-seeded demo accounts above.');" class="text-[11px] text-brand-600 hover:text-brand-800 transition">Forgot?</a>
          </div>
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              required
              placeholder="Enter your password" 
              class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition"
            >
            <i class="fa-solid fa-lock absolute left-3.5 top-3 text-slate-400 text-xs"></i>
            <button type="button" data-target="password" class="toggle-password-btn absolute right-3.5 top-2.5 text-slate-400 hover:text-slate-600 transition">
              <i class="fa-regular fa-eye text-xs"></i>
            </button>
          </div>
        </div>

        <!-- Remember Me -->
        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="remember_me" class="rounded text-brand-600 focus:ring-brand-500">
            <span class="text-xs text-slate-600">Remember me for 30 days</span>
          </label>
        </div>

        <!-- Submit Button -->
        <div class="pt-3">
          <button type="submit" class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-lg shadow-brand-600/30 transition">
            Sign In
          </button>
        </div>
      </form>

      <!-- Register Link -->
      <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
        Don't have an account yet? 
        <a href="/register" class="font-bold text-brand-600 hover:text-brand-800 transition ml-1">Create one now</a>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
