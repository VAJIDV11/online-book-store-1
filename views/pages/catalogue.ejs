<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-8 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb & Header -->
    <div class="mb-6">
      <nav class="flex items-center text-xs text-slate-500 space-x-2">
        <a href="/" class="hover:text-brand-600 transition">Home</a>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">Book Catalogue</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-2">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Explore Our Book Collection</h1>
        <p class="text-xs text-slate-500">Showing <span class="font-bold text-slate-800"><%= books.length %></span> of <span class="font-bold text-slate-800"><%= totalBooks %></span> books</p>
      </div>
    </div>

    <!-- Main Layout: Sidebar + Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- 1. Filter Sidebar -->
      <aside class="lg:col-span-1">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm sticky top-24 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <i class="fa-solid fa-sliders text-brand-600"></i> Filters
            </h3>
            <a href="/catalogue" class="text-xs text-brand-600 hover:text-brand-800 font-semibold transition">Reset All</a>
          </div>

          <form action="/catalogue" method="GET" class="space-y-6">
            
            <!-- Search Keyword -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Keyword</label>
              <div class="relative">
                <input 
                  type="text" 
                  name="q" 
                  value="<%= filters.q %>" 
                  placeholder="Title, author, ISBN..." 
                  class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:border-brand-500"
                >
                <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-400 text-xs"></i>
              </div>
            </div>

            <!-- Categories -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Category</label>
              <select name="category" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:border-brand-500">
                <option value="all" <%= (!filters.category || filters.category === 'all') ? 'selected' : '' %>>All Categories</option>
                <% if (typeof categories !== 'undefined') { %>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.slug %>" <%= (filters.category === cat.slug || filters.category == cat.id) ? 'selected' : '' %>>
                      <%= cat.name %> (<%= cat.book_count || 0 %>)
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <!-- Price Range -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Price Range ($)</label>
              <div class="flex items-center gap-2">
                <input 
                  type="number" 
                  name="min_price" 
                  value="<%= filters.min_price %>" 
                  placeholder="Min" 
                  min="0"
                  class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:border-brand-500"
                >
                <span class="text-slate-400 text-xs">-</span>
                <input 
                  type="number" 
                  name="max_price" 
                  value="<%= filters.max_price %>" 
                  placeholder="Max" 
                  min="0"
                  class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:border-brand-500"
                >
              </div>
            </div>

            <!-- Rating Filter -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Minimum Rating</label>
              <div class="space-y-1.5 text-xs text-slate-600">
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="radio" name="rating" value="" <%= !filters.rating ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
                  <span>Any Rating</span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="radio" name="rating" value="4.5" <%= filters.rating === '4.5' ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
                  <span class="flex items-center text-amber-500"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i> <span class="text-slate-700 ml-1">4.5 & up</span></span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="radio" name="rating" value="4.0" <%= filters.rating === '4.0' ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
                  <span class="flex items-center text-amber-500"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-regular fa-star"></i> <span class="text-slate-700 ml-1">4.0 & up</span></span>
                </label>
              </div>
            </div>

            <!-- In Stock Checkbox -->
            <div class="pt-2 border-t border-slate-100">
              <label class="flex items-center space-x-2 cursor-pointer text-xs font-semibold text-slate-700">
                <input type="checkbox" name="in_stock" value="true" <%= (filters.in_stock === 'true' || filters.in_stock === 'on') ? 'checked' : '' %> class="rounded text-brand-600 focus:ring-brand-500">
                <span>In Stock Only</span>
              </label>
            </div>

            <!-- Sort preserve in filter form -->
            <input type="hidden" name="sort" value="<%= filters.sort %>">

            <!-- Submit Button -->
            <button type="submit" class="w-full py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-lg shadow-sm transition">
              Apply Filters
            </button>
          </form>
        </div>
      </aside>

      <!-- 2. Products Section -->
      <section class="lg:col-span-3">
        
        <!-- Sorting & Views Bar -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 mb-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
          
          <div class="flex items-center space-x-2 text-xs text-slate-500">
            <span>Sort by:</span>
            <form id="sort-form" action="/catalogue" method="GET" class="inline-block">
              <!-- Hidden inputs to preserve current filters -->
              <input type="hidden" name="q" value="<%= filters.q %>">
              <input type="hidden" name="category" value="<%= filters.category %>">
              <input type="hidden" name="min_price" value="<%= filters.min_price %>">
              <input type="hidden" name="max_price" value="<%= filters.max_price %>">
              <input type="hidden" name="rating" value="<%= filters.rating %>">
              <input type="hidden" name="in_stock" value="<%= filters.in_stock %>">

              <select name="sort" onchange="document.getElementById('sort-form').submit()" class="bg-slate-50 border border-slate-200 rounded-lg text-xs py-1.5 px-3 text-slate-800 font-semibold focus:outline-none focus:border-brand-500">
                <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest Arrivals</option>
                <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="rating_desc" <%= filters.sort === 'rating_desc' ? 'selected' : '' %>>Highest Rated</option>
                <option value="title_asc" <%= filters.sort === 'title_asc' ? 'selected' : '' %>>Alphabetical (A-Z)</option>
              </select>
            </form>
          </div>

          <div class="text-xs text-slate-500">
            Page <span class="font-bold text-slate-800"><%= currentPage %></span> of <span class="font-bold text-slate-800"><%= totalPages %></span>
          </div>

        </div>

        <!-- Books Grid -->
        <% if (books.length === 0) { %>
          <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-2xl mb-4">
              <i class="fa-solid fa-book-open"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">No Books Found</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">We couldn't find any books matching your active filter criteria. Try adjusting your filters or search terms.</p>
            <a href="/catalogue" class="mt-4 inline-block px-4 py-2 bg-brand-600 text-white rounded-lg text-xs font-semibold hover:bg-brand-700 transition">Reset Filters</a>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            <% books.forEach(book => { %>
              <div class="book-card bg-white rounded-2xl border border-slate-200/80 overflow-hidden flex flex-col justify-between shadow-sm">
                <div>
                  <!-- Image Box -->
                  <div class="relative bg-slate-50 p-6 flex items-center justify-center img-zoom-container h-64">
                    <% if (book.discount_price) { %>
                      <span class="badge-discount absolute top-3 left-3 text-white text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full shadow-sm">
                        Sale
                      </span>
                    <% } %>
                    <% if (book.stock_quantity <= 0) { %>
                      <span class="absolute top-3 right-3 bg-rose-600 text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded shadow-sm">
                        Sold Out
                      </span>
                    <% } %>
                    <img src="<%= book.cover_image || 'https://covers.openlibrary.org/b/isbn/9780132350884-L.jpg' %>" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80';" alt="<%= book.title %>" class="h-48 object-cover rounded shadow-md">
                    
                    <button type="button" data-book-id="<%= book.id %>" class="quick-view-btn absolute bottom-3 bg-white/90 hover:bg-white text-slate-800 text-xs font-semibold px-3 py-1.5 rounded-full shadow-md backdrop-blur transition flex items-center gap-1.5">
                      <i class="fa-regular fa-eye"></i> Quick View
                    </button>
                  </div>

                  <!-- Details -->
                  <div class="p-5">
                    <span class="text-[11px] font-semibold text-brand-600 uppercase tracking-wider"><%= book.category_name %></span>
                    <h3 class="font-bold text-sm text-slate-900 mt-1 line-clamp-1 hover:text-brand-600 transition">
                      <a href="/books/<%= book.id %>"><%= book.title %></a>
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5"><%= book.author %></p>

                    <div class="flex items-center space-x-1 mt-2 text-amber-400 text-xs">
                      <i class="fa-solid fa-star"></i>
                      <span class="font-bold text-slate-700 ml-1"><%= book.rating || '4.5' %></span>
                      <span class="text-slate-400">(<%= book.rating_count || 12 %>)</span>
                    </div>
                  </div>
                </div>

                <!-- Price & Add to Cart -->
                <div class="px-5 pb-5 pt-2 border-t border-slate-100 flex items-center justify-between">
                  <div>
                    <% if (book.discount_price) { %>
                      <span class="text-base font-extrabold text-slate-900">$<%= parseFloat(book.discount_price).toFixed(2) %></span>
                      <span class="text-xs text-slate-400 line-through ml-1">$<%= parseFloat(book.price).toFixed(2) %></span>
                    <% } else { %>
                      <span class="text-base font-extrabold text-slate-900">$<%= parseFloat(book.price).toFixed(2) %></span>
                    <% } %>
                  </div>

                  <% if (book.stock_quantity > 0) { %>
                    <form action="/cart/add" method="POST">
                      <input type="hidden" name="book_id" value="<%= book.id %>">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="p-2.5 rounded-xl bg-brand-50 hover:bg-brand-600 text-brand-600 hover:text-white transition shadow-sm" title="Add to Cart">
                        <i class="fa-solid fa-cart-plus text-sm"></i>
                      </button>
                    </form>
                  <% } else { %>
                    <button disabled class="p-2.5 rounded-xl bg-slate-100 text-slate-400 cursor-not-allowed text-xs font-semibold">
                      Out of Stock
                    </button>
                  <% } %>
                </div>

              </div>
            <% }) %>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="mt-10 flex items-center justify-center space-x-2">
              
              <!-- Previous Page -->
              <% if (currentPage > 1) { %>
                <a href="/catalogue?page=<%= currentPage - 1 %>&q=<%= filters.q %>&category=<%= filters.category %>&min_price=<%= filters.min_price %>&max_price=<%= filters.max_price %>&rating=<%= filters.rating %>&in_stock=<%= filters.in_stock %>&sort=<%= filters.sort %>" class="px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition">
                  &larr; Previous
                </a>
              <% } %>

              <!-- Page numbers -->
              <% for (let p = 1; p <= totalPages; p++) { %>
                <a href="/catalogue?page=<%= p %>&q=<%= filters.q %>&category=<%= filters.category %>&min_price=<%= filters.min_price %>&max_price=<%= filters.max_price %>&rating=<%= filters.rating %>&in_stock=<%= filters.in_stock %>&sort=<%= filters.sort %>" class="w-9 h-9 flex items-center justify-center rounded-lg text-xs font-bold transition <%= (p === currentPage) ? 'bg-brand-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
                  <%= p %>
                </a>
              <% } %>

              <!-- Next Page -->
              <% if (currentPage < totalPages) { %>
                <a href="/catalogue?page=<%= currentPage + 1 %>&q=<%= filters.q %>&category=<%= filters.category %>&min_price=<%= filters.min_price %>&max_price=<%= filters.max_price %>&rating=<%= filters.rating %>&in_stock=<%= filters.in_stock %>&sort=<%= filters.sort %>" class="px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition">
                  Next &rarr;
                </a>
              <% } %>

            </div>
          <% } %>

        <% } %>

      </section>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
