<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 py-12 bg-slate-50 flex items-center justify-center">
  <div class="max-w-2xl w-full mx-4">
    
    <!-- Receipt Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden p-6 sm:p-10">
      
      <!-- Top Success Icon -->
      <div class="text-center pb-6 border-b border-slate-100">
        <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto text-2xl mb-3 shadow-inner">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Order Confirmed!</h1>
        <p class="text-xs text-slate-500 mt-1">Thank you for your purchase. We have received your order and are preparing it for shipment.</p>
        <span class="inline-block mt-3 px-3 py-1 bg-slate-100 text-slate-700 font-mono text-xs font-bold rounded-full">
          Order #<%= order.id %>
        </span>
      </div>

      <!-- Order Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-b border-slate-100 text-xs">
        <div>
          <span class="text-slate-400 block">Date Placed</span>
          <span class="font-bold text-slate-800"><%= new Date(order.created_at).toLocaleDateString() %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Payment Method</span>
          <span class="font-bold text-slate-800"><%= order.payment_method %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Payment Status</span>
          <span class="font-bold text-emerald-600"><%= order.payment_status %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Order Status</span>
          <span class="font-bold text-brand-600"><%= order.order_status %></span>
        </div>
      </div>

      <!-- Shipping Destination -->
      <div class="py-4 border-b border-slate-100 text-xs">
        <span class="text-slate-400 block font-semibold uppercase tracking-wider text-[10px]">Shipping Destination</span>
        <p class="font-bold text-slate-900 mt-0.5"><%= order.shipping_name %> (<%= order.shipping_phone %>)</p>
        <p class="text-slate-600"><%= order.shipping_address %></p>
      </div>

      <!-- Items List -->
      <div class="py-6 border-b border-slate-100 space-y-3">
        <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Ordered Books</h3>
        <div class="divide-y divide-slate-100">
          <% items.forEach(item => { %>
            <div class="py-3 flex items-center justify-between text-xs">
              <div class="flex items-center space-x-3">
                <img src="<%= item.cover_image || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80' %>" alt="<%= item.title %>" class="w-10 h-14 object-cover rounded shadow-2xs">
                <div>
                  <h4 class="font-bold text-slate-900"><%= item.title %></h4>
                  <p class="text-slate-500 text-[11px]">Qty: <%= item.quantity %> × $<%= parseFloat(item.unit_price).toFixed(2) %></p>
                </div>
              </div>
              <span class="font-bold text-slate-800">$<%= (item.unit_price * item.quantity).toFixed(2) %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Total -->
      <div class="py-6 flex items-baseline justify-between">
        <span class="text-sm font-bold text-slate-900">Total Paid</span>
        <span class="text-2xl font-extrabold text-brand-600">$<%= parseFloat(order.total_amount).toFixed(2) %></span>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <button onclick="window.print()" class="flex-1 py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center justify-center space-x-2">
          <i class="fa-solid fa-print"></i>
          <span>Print Receipt</span>
        </button>
        <a href="/profile" class="flex-1 py-3 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center justify-center space-x-2">
          <i class="fa-solid fa-box"></i>
          <span>View in Order History</span>
        </a>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
