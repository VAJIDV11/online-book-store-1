</footer>

<!-- Reusable Quick View Modal -->
<div id="quick-view-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto">
  <div class="bg-white rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl relative animate-fade-in my-8">
    <button id="quick-view-close" type="button" class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition">
      <i class="fa-solid fa-xmark text-base"></i>
    </button>
    
    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Image side -->
      <div class="bg-slate-50 p-8 flex items-center justify-center">
        <img id="qv-image" src="" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80';" alt="Book Cover" class="h-72 object-cover rounded-lg shadow-md">
      </div>

      <!-- Content side -->
      <div class="p-6 md:p-8 flex flex-col justify-between space-y-4">
        <div>
          <span id="qv-category" class="text-xs font-semibold text-brand-600 uppercase tracking-wider"></span>
          <h3 id="qv-title" class="text-xl font-bold text-slate-900 mt-1"></h3>
          <p id="qv-author" class="text-sm text-slate-500 font-medium"></p>
          
          <div class="flex items-center space-x-2 mt-2">
            <div class="flex text-amber-400 text-xs">
              <i class="fa-solid fa-star"></i>
            </div>
            <span id="qv-rating" class="text-xs font-bold text-slate-800"></span>
            <span id="qv-rating-count" class="text-xs text-slate-400"></span>
          </div>

          <div class="mt-4 flex items-baseline space-x-2">
            <span id="qv-price" class="text-2xl font-extrabold text-slate-900"></span>
            <span id="qv-discount" class="text-sm line-through text-slate-400 hidden"></span>
          </div>

          <div class="mt-2">
            <span id="qv-stock"></span>
          </div>

          <p id="qv-description" class="text-sm text-slate-600 mt-3 line-clamp-3 leading-relaxed"></p>
        </div>

        <div class="space-y-3 pt-4 border-t border-slate-100">
          <form action="/cart/add" method="POST" class="flex gap-2">
            <input type="hidden" id="qv-book-id" name="book_id" value="">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="flex-1 py-2.5 px-4 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg shadow-sm transition flex items-center justify-center space-x-2">
              <i class="fa-solid fa-cart-plus"></i>
              <span>Add to Cart</span>
            </button>
          </form>
          <a id="qv-detail-link" href="#" class="block text-center text-xs font-semibold text-brand-600 hover:text-brand-800 transition">
            View Full Book Details &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="/js/main.js"></script>
<script src="/js/validation.js"></script>
</body>
</html>
