      <p>&copy; <%= new Date().getFullYear() %> BookHaven Online Store. All rights reserved.</p>
      <div class="flex space-x-6">
        <span><i class="fa-solid fa-lock mr-1 text-emerald-500"></i> SSL 256-Bit Encrypted</span>
        <span><i class="fa-solid fa-shield-halved mr-1 text-brand-400"></i> Secure MySQL Transactions</span>
      </div>
    </div>
