<footer class="mt-auto bg-slate-900 text-slate-400 text-sm">
  <!-- Newsletter Section -->
  <div class="border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white tracking-tight">Stay updated with fresh book arrivals</h3>
          <p class="text-slate-400 mt-1">Get curated reading lists, author spotlights, and exclusive discounts delivered to your inbox.</p>
        </div>
        <form onsubmit="event.preventDefault(); alert('Thank you for subscribing to BookHaven updates!');" class="flex w-full max-w-md gap-2">
          <input 
            type="email" 
            required 
            placeholder="Enter your email address" 
            class="flex-1 px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          >
          <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-lg transition shrink-0 shadow-lg shadow-brand-600/30">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Main Footer Links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center text-white font-bold">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <span class="font-bold text-xl text-white tracking-tight">BookHaven</span>
        </div>
        <p class="text-slate-400 pr-6 leading-relaxed">
          Your premier online destination for curated literature, programming manuals, science discoveries, and personal growth bestsellers.
        </p>
        <div class="flex space-x-4 pt-2">
          <a href="#" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center hover:bg-brand-600 hover:text-white transition"><i class="fa-brands fa-github text-sm"></i></a>
          <a href="#" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center hover:bg-brand-600 hover:text-white transition"><i class="fa-brands fa-twitter text-sm"></i></a>
          <a href="#" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center hover:bg-brand-600 hover:text-white transition"><i class="fa-brands fa-linkedin text-sm"></i></a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-xs tracking-wider uppercase">Explore</h4>
        <ul class="space-y-2.5">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li><a href="/catalogue" class="hover:text-white transition">All Books</a></li>
          <li><a href="/catalogue?sort=newest" class="hover:text-white transition">New Releases</a></li>
          <li><a href="/catalogue?sort=rating_desc" class="hover:text-white transition">Top Rated</a></li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-xs tracking-wider uppercase">Genres</h4>
        <ul class="space-y-2.5">
          <li><a href="/catalogue?category=technology" class="hover:text-white transition">Technology</a></li>
          <li><a href="/catalogue?category=fiction" class="hover:text-white transition">Fiction</a></li>
          <li><a href="/catalogue?category=science" class="hover:text-white transition">Science & Nature</a></li>
          <li><a href="/catalogue?category=business" class="hover:text-white transition">Business & Finance</a></li>
          <li><a href="/catalogue?category=self-help" class="hover:text-white transition">Self-Help</a></li>
        </ul>
      </div>

      <!-- Customer Support -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-xs tracking-wider uppercase">Account & Help</h4>
        <ul class="space-y-2.5">
          <li><a href="/profile" class="hover:text-white transition">My Account</a></li>
          <li><a href="/cart" class="hover:text-white transition">View Cart</a></li>
          <li><a href="/login" class="hover:text-white transition">Sign In</a></li>
          <li><a href="/register" class="hover:text-white transition">Register</a></li>
