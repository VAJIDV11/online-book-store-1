<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="flex-1 py-16 bg-slate-50 flex items-center justify-center">
  <div class="max-w-lg w-full mx-4 text-center">
    <div class="w-20 h-20 rounded-3xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto text-3xl mb-4 shadow-sm">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <span class="text-xs font-bold text-rose-600 uppercase tracking-widest">Error 500</span>
    <h1 class="text-3xl font-extrabold text-slate-900 mt-1">Internal Server Error</h1>
    <p class="text-xs text-slate-500 mt-2 max-w-sm mx-auto leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred on the server. Our technical team has been notified.' %>
    </p>

    <% if (typeof error !== 'undefined' && error && error.stack) { %>
      <div class="mt-6 text-left bg-slate-900 text-slate-200 p-4 rounded-xl text-[11px] font-mono overflow-x-auto max-h-48">
        <p class="text-rose-400 font-bold mb-1"><%= error.message %></p>
        <pre><%= error.stack %></pre>
      </div>
    <% } %>

    <div class="mt-8 flex justify-center space-x-3">
      <a href="/" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md transition">
        Return to Home
      </a>
      <button onclick="window.location.reload()" class="px-5 py-2.5 bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 shadow-sm transition">
        Try Again
      </button>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
